<%inc #include "../dto/PcPartDto.hpp" 

%>
<!DOCTYPE html>
<html lang="en">

<head>
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
    <meta charset="utf-8" />
    <title>Login Page - CMS PURCHASING</title>
    
    <meta name="description" content="User login page" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Tangerine">
    <!-- bootstrap & fontawesome -->
    <link rel="stylesheet" href="/static/assets/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/static/assets/font-awesome/4.5.0/css/font-awesome.min.css" />

    <!-- text fonts -->
    <link rel="stylesheet" href="/static/assets/css/fonts.googleapis.com.css" />
    <link href="/static/assets/css/jquery.growl.css" rel="stylesheet" />
    <!-- ace styles -->
    <link rel="stylesheet" href="/static/assets/css/ace.min.css" />
    <link href="/static/assets/css/master.css" rel="stylesheet" />
    <link rel="stylesheet" href="/static/assets/css/chosen.min.css" />
    <!--[if lte IE 9]>
			<link rel="stylesheet" href="/static/assets/css/ace-part2.min.css" />
		<![endif]-->
    <link rel="stylesheet" href="/static/assets/css/ace-rtl.min.css" />

    <!--[if lte IE 9]>
		  <link rel="stylesheet" href="/static/assets/css/ace-ie.min.css" />
		<![endif]-->

    <!-- HTML5shiv and Respond.js for IE8 to support HTML5 elements and media queries -->

    <!--[if lte IE 8]>
		<script src="/static/assets/js/html5shiv.min.js"></script>
		<script src="/static/assets/js/respond.min.js"></script>
		<![endif]-->
    
</head>

<body class="login-layout light-login">
<%c++

        using pcPartDto = app_dto::PcPartDto;
        auto listParts=@@.get<std::vector<pcPartDto>>("listPart");
	
	%>
    <div class="main-container">
        <div class="main-content">
            <div class="row">
                <div class="col-sm-10 col-sm-offset-1" style="padding-top:40px;">
                    <div class="login-container">
                        <div class="center">
                            <h2>
                                <img src="/static/image/login-LogoNOK.png" height="40" />
                                <span class="red">CMS</span>
                                <span style="color: #0019d8!important;font-weight: bold;"
                                    id="id-text2">Purchasing</span>
                            </h2>
                        </div>

                        <div class="space-6"></div>

                        <div class="position-relative">
                            <div id="login-box" class="login-box visible widget-box no-border">
                                <div class="widget-body">
                                    <div class="widget-main">
                                        <h3 class="header blue lighter bigger">
                                            <i class="ace-icon fa fa-coffee green"></i>

                                            Vui l&#xF2;ng &#x111;&#x103;ng nh&#x1EAD;p !
                                        </h3>

                                        <div class="space-6"></div>
<form action="/purchasing/home" data-ajax="true" data-ajax-begin="OnBegin" data-ajax-cache="true" data-ajax-complete="OnComplete" data-ajax-failure="OnFailureLogin" data-ajax-method="POST" data-ajax-success="OnSuccessLogin" id="popup-login" method="post">                                            <fieldset>
                                                <label class="block clearfix">
                                                    <span class="block input-icon input-icon-right">
                                                        <input autocomplete="off" class="form-control" data-val="true" data-val-required="The Username field is required." id="Username" name="Username" placeholder="T&#xE0;i Kho&#x1EA3;n" required="required" style="Width:100% !important;" type="text" value="" />
                                                        <i class="ace-icon fa fa-user"></i>
                                                    </span>
                                                </label>

                                                <label class="block clearfix">
                                                    <span class="block input-icon input-icon-right">
                                                        <input autocomplete="off" class="form-control" data-val="true" data-val-required="The Password field is required." id="Password" name="Password" placeholder="M&#x1EAD;t Kh&#x1EA9;u" required="required" style="Width:100% !important;" type="password" />
                                                        <i class="ace-icon fa fa-lock"></i>
                                                    </span>
                                                </label>
                                                <label class="block clearfix">
                                                    <span class="block input-icon input-icon-right">
                                                        <select class="chosen-select" data-placeholder="Choose..." id="partCode" name="partCode" style="Width:100%"><option value="">B&#x1ED9; ph&#x1EAD;n ch&#xED;nh</option>
                                                       
	

    <%c++ for(auto part : listParts) {%>
              
              <option value=<%c++ $$<<"\"" +  part.COSTCODE + "\"" ;%>><%c++  $$<<part.PARTNAME; %></option>
    <%c++ } %>

</select>
                                                    </span>
                                                </label>
                                                <div class="space"></div>
                                                <div class="clearfix">

                                                    <button type="submit"
                                                        class="width-35 pull-right btn btn-sm btn-primary">
                                                        <i class="ace-icon fa fa-key"></i>
                                                        <span class="bigger-110">Login</span>
                                                    </button>
                                                </div>

                                                <div class="space-4"></div>
                                            </fieldset>
<input name="__RequestVerificationToken" type="hidden" value="CfDJ8E-WbZKXGhNNkDfn5Lyo-aMsg9ZEB5_LnuO-Nh5HomfLRPugAPy9FkWxojH3opLDTP_JhkLrd_6MhIagxHbvkjb44O__AlkmovY--lgPBFbkB6fRZ7dRqPgmOd_nJXNImUMJ7xo1fFkBS_d55QhkNYU" /></form>
                                    </div>
                                    <!-- /.widget-main -->

                                </div>
                                <!-- /.widget-body -->
                            </div>
                            <!-- /.login-box -->


                        </div>
                        <!-- /.position-relative -->

                    </div>
                </div>
                <!-- /.col -->
            </div>
            <!-- /.row -->
        </div>
        <!-- /.main-content -->
    </div>
    <div id="ac-wrapper_loading" style="display: none">
    </div>
    <!-- /.main-container -->

    <!-- basic scripts -->

    <!--[if !IE]> -->
    <script src="/static/assets/js/jquery-2.1.4.min.js"></script>
    <script src="/static/Scripts/jquery-1.7.1.min.js"></script>
    <script src="/static/Scripts/jquery.unobtrusive-ajax.js"></script>
    <script src="/static/assets/js/chosen.jquery.min.js"></script>
    <script src="/static/assets/js/ace.min.js"></script>
    <script src="/static/ajax/master.js"></script>
    <script src="/static/Scripts/jquery.growl.js"></script>
    <!-- <![endif]-->

    <!--[if IE]>
<script src="/static/assets/js/jquery-1.11.3.min.js"></script>
<![endif]-->
    <script type="text/javascript">
        if ('ontouchstart' in document.documentElement) document.write("<script src='/static/assets/js/jquery.mobile.custom.min.js'>" + "<" + "/script>");
    </script>

    <!-- inline scripts related to this page -->
    <script type="text/javascript">

        jQuery(function ($) {

            $(document).on('click', '.toolbar a[data-target]', function (e) {
                e.preventDefault();
                var target = $(this).data('target');
                $('.widget-box.visible').removeClass('visible');//hide others
                $(target).addClass('visible');//show target
            });

            if (!ace.vars['touch']) {
                $('.chosen-select').chosen({ allow_single_deselect: true });
                //resize the chosen on window resize

                $(window)
                    .off('resize.chosen')
                    .on('resize.chosen', function () {
                        $('.chosen-select').each(function () {
                            var $this = $(this);
                            $this.next().css({ 'width': $this.parent().width() });
                        })
                    }).trigger('resize.chosen');
                //resize chosen on sidebar collapse/expand
                $(document).on('settings.ace.chosen', function (e, event_name, event_val) {
                    if (event_name != 'sidebar_collapsed') return;
                    $('.chosen-select').each(function () {
                        var $this = $(this);
                        $this.next().css({ 'width': $this.parent().width() });
                    })
                });
            }
        });




    </script>
</body>

</html>
